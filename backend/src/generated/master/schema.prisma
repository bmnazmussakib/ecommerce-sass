datasource db {
  provider  = "postgresql"
  url       = env("MASTER_DATABASE_URL")
  directUrl = env("MASTER_DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/master"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model SuperAdmin {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  password         String
  twoFactorSecret  String?
  twoFactorEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model Tenant {
  id                    String                @id @default(uuid())
  subdomain             String                @unique
  customDomain          String?               @unique
  customDomainStatus    String                @default("PENDING") // PENDING, VERIFIED, FAILED, ACTIVE
  customDomainSslStatus String                @default("PENDING") // PENDING, ISSUED, ACTIVE, FAILED
  status                TenantStatus          @default(PENDING)
  dbConnectionString    String
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  featureToggles        Json                  @default("{}")
  subscription          Subscription?
  payments              SubscriptionPayment[]
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model Plan {
  id            String                @id @default(uuid())
  name          String
  productLimit  Int
  trafficLimit  Int
  storageLimit  Int
  price         Decimal               @db.Decimal(10, 2)
  currency      String                @default("USD")
  interval      BillingCycle          @default(MONTHLY)
  prices        PlanPricing[]
  subscriptions Subscription[]
  payments      SubscriptionPayment[]
}

model PlanPricing {
  id        String   @id @default(uuid())
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  currency  String // e.g. "USD", "BDT", "EUR", "GBP"
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, currency])
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model Subscription {
  id                   String             @id @default(uuid())
  tenantId             String             @unique
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id])
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  stripeSubscriptionId String?
  createdAt            DateTime           @default(now())
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

model GlobalTheme {
  id             String   @id @default(uuid())
  name           String
  codeIdentifier String   @unique
  previewUrl     String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model TrafficLog {
  id       String   @id @default(uuid())
  tenantId String
  date     DateTime @db.Date
  count    Int      @default(0)

  @@unique([tenantId, date])
}

model SubscriptionPayment {
  id            String               @id @default(uuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId        String
  plan          Plan                 @relation(fields: [planId], references: [id])
  amount        Decimal              @db.Decimal(10, 2)
  method        BillingPaymentMethod
  gateway       String? // 'SSLCOMMERZ'
  status        BillingPaymentStatus @default(PENDING)
  transactionId String?              @unique
  senderNumber  String?
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

enum BillingPaymentMethod {
  GATEWAY
  MANUAL
}

enum BillingPaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  userId    String?
  userEmail String?
  userRole  String?
  details   Json?
  createdAt DateTime @default(now())
}
